+
+bool CPDF_Form::CloneStreamForEditing() {
+  RetainPtr<CPDF_Stream> cloned_stream = ToStream(form_stream_->Clone());
+  if (!cloned_stream) {
+    return false;
+  }
+
+  GetDocument()->AddIndirectObject(cloned_stream);
+  RetainPtr<CPDF_Dictionary> cloned_dict = cloned_stream->GetMutableDict();
+  SetDictForEditing(cloned_dict);
+  RetainPtr<CPDF_Dictionary> resources = GetMutableResources();
+  if (resources) {
+    RetainPtr<CPDF_Dictionary> cloned_resources =
+        pdfium::WrapRetain(resources->Clone()->AsMutableDictionary());
+    const uint32_t resources_object_number =
+        GetDocument()->AddIndirectObject(cloned_resources);
+    cloned_dict->SetNewFor<CPDF_Reference>(
+        "Resources", GetDocument(), resources_object_number);
+    SetResources(std::move(cloned_resources));
+  }
+  form_stream_ = std::move(cloned_stream);
+  return true;
+}
