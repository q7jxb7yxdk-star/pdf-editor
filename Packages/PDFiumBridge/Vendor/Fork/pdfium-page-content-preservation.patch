+bool CPDF_PageContentGenerator::WriteColorToStream(
+    fxcrt::ostringstream* buf,
+    const CPDF_Color* color,
+    bool stroke) {
+  if (!color || color->IsNull()) {
+    return false;
+  }
+  if (!color->IsPattern()) {
+    if (!WriteRGBColorToStream(*buf, color)) {
+      return false;
+    }
+    *buf << (stroke ? " RG " : " rg ");
+    return true;
+  }
+
+  RetainPtr<CPDF_Pattern> pattern = color->GetPattern();
+  if (!pattern) {
+    return false;
+  }
+  RetainPtr<CPDF_Object> pattern_object = pattern->GetPatternObject();
+  if (!pattern_object) {
+    return false;
+  }
+  if (pattern_object->IsInline()) {
+    pattern_object = pattern_object->Clone();
+    document_->AddIndirectObject(pattern_object);
+  }
+  const ByteString pattern_name =
+      RealizeResource(pattern_object.Get(), "Pattern");
+
+  CPDF_TilingPattern* tiling_pattern = pattern->AsTilingPattern();
+  if (tiling_pattern && !tiling_pattern->colored()) {
+    std::optional<FX_RGB_STRUCT<float>> rgb = color->GetRGB();
+    if (!rgb.has_value()) {
+      return false;
+    }
+    auto pattern_color_space = pdfium::MakeRetain<CPDF_Array>();
+    pattern_color_space->AppendNew<CPDF_Name>("Pattern");
+    pattern_color_space->AppendNew<CPDF_Name>("DeviceRGB");
+    document_->AddIndirectObject(pattern_color_space);
+    const ByteString color_space_name =
+        RealizeResource(pattern_color_space.Get(), "ColorSpace");
+    *buf << "/" << PDF_NameEncode(color_space_name)
+         << (stroke ? " CS " : " cs ");
+    WriteFloat(*buf, rgb->red) << " ";
+    WriteFloat(*buf, rgb->green) << " ";
+    WriteFloat(*buf, rgb->blue) << " ";
+  } else {
+    *buf << "/Pattern" << (stroke ? " CS " : " cs ");
+  }
+  *buf << "/" << PDF_NameEncode(pattern_name)
+       << (stroke ? " SCN " : " scn ");
+  return true;
+}
