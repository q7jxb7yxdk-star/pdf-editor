+void CPDF_PageContentGenerator::ProcessShading(
+    fxcrt::ostringstream* buf,
+    CPDF_ShadingObject* pShadingObj) {
+  ByteString name = pShadingObj->GetResourceName();
+  if (name.IsEmpty()) {
+    RetainPtr<const CPDF_Object> shading_object =
+        pShadingObj->pattern()->GetShadingObject();
+    if (!shading_object) {
+      return;
+    }
+    name = RealizeResource(shading_object.Get(), "Shading");
+    pShadingObj->SetResourceName(name);
+  }
+
+  ProcessGraphics(buf, pShadingObj);
+  if (!pShadingObj->matrix().IsIdentity()) {
+    WriteMatrix(*buf, pShadingObj->matrix()) << " cm ";
+  }
+  *buf << "/" << PDF_NameEncode(name) << " sh";
+  EndProcessGraphics(*buf);
+}
