+void CPDF_PageContentGenerator::GenerateFullPageContent() {
+  CHECK(obj_holder_->IsPage());
+  fxcrt::ostringstream stream_data;
+  stream_data << "q\n";
+  ProcessDefaultGraphics(&stream_data);
+  ProcessPageObjects(&stream_data);
+  stream_data << "Q\n";
+
+  auto stream = document_->NewIndirect<CPDF_Stream>(&stream_data);
+  obj_holder_->GetMutableDict()->SetNewFor<CPDF_Reference>(
+      pdfium::page_object::kContents, document_, stream->GetObjNum());
+  for (CPDF_PageObject* page_object : page_objects_) {
+    if (page_object->IsActive()) {
+      page_object->SetContentStream(0);
+    }
+  }
+  obj_holder_->TakeDirtyStreams();
+  obj_holder_->ClearFullContentRegeneration();
   UpdateResourcesDict();
 }
 
