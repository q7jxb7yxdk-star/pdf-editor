+bool CPDF_PageObjectHolder::MovePageObjectAtIndex(
+    size_t source_index,
+    size_t destination_index) {
+  if (source_index >= page_object_list_.size() ||
+      destination_index >= page_object_list_.size()) {
+    return false;
+  }
+  if (source_index == destination_index) {
+    return true;
+  }
+
+  std::unique_ptr<CPDF_PageObject> object =
+      std::move(page_object_list_[source_index]);
+  page_object_list_.erase(
+      UNSAFE_TODO(page_object_list_.begin() + source_index));
+  page_object_list_.insert(
+      UNSAFE_TODO(page_object_list_.begin() + destination_index),
+      std::move(object));
+  for (const auto& page_object : page_object_list_) {
+    page_object->SetDirty(true);
+  }
+  needs_full_content_regeneration_ = IsPage();
+  return true;
+}
