+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFImageObj_SetBitmapIsolated(FPDF_PAGE* pages,
+                               int count,
+                               FPDF_PAGEOBJECT image_object,
+                               FPDF_BITMAP bitmap) {
+  CPDF_ImageObject* image = CPDFImageObjectFromFPDFPageObject(image_object);
+  if (!image) {
+    return false;
+  }
+
+  RetainPtr<CFX_DIBitmap> bitmap_holder(CFXDIBitmapFromFPDFBitmap(bitmap));
+  if (!bitmap_holder) {
+    return false;
+  }
+  ValidateBitmapPremultiplyState(bitmap_holder);
+
+  RetainPtr<CPDF_Image> old_image = image->GetImage();
+  if (pages) {
+    for (int index = 0; index < count; ++index) {
+      CPDF_Page* page = CPDFPageFromFPDFPage(UNSAFE_TODO(pages[index]));
+      if (page) {
+        old_image->ResetCache(page);
+      }
+    }
+  }
+
+  auto isolated_image =
+      pdfium::MakeRetain<CPDF_Image>(old_image->GetDocument());
+  isolated_image->SetImage(bitmap_holder);
+  image->SetImage(std::move(isolated_image));
+  image->CalcBoundingBox();
+  image->SetDirty(true);
+  return true;
+}
